# ---- 凭证配置 ----
# 复制本文件为 .env 再填值。.env 不要提交、不要放进 DSH profile。
# 只填你已拿到的那几家即可；未填的平台会自动以 mock 模式运行。
#
# 查当前状态：调用 MCP 工具 shopping_status

# ============ 淘宝联盟 / 淘宝客 ============
# 来源：淘宝开放平台应用 appkey+secret；session 由 oauth.taobao.com 授权取得
# PID 形如 mm_12345678_901234567_10987654321（三段数字）
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
TAOBAO_SESSION=
TAOBAO_PID=

# ============ 京东联盟 ============
# 来源：union.jd.com（联盟后台）+ 京东开放平台应用；SITE_ID/POSITION_ID 取联盟后台的网站ID/推广位ID
JD_APP_KEY=
JD_APP_SECRET=
JD_SITE_ID=
JD_POSITION_ID=

# ============ 拼多多多多进宝 ============
# 来源：open.pinduoduo.com 创建应用取 client_id/client_secret；PID 取多多进宝推广位
# 三家之中个人注册门槛最低，建议先跑通这家
PDD_CLIENT_ID=
PDD_CLIENT_SECRET=
PDD_PID=

# ============ 可选 ============
# 设为 1 时强制所有平台走 mock（即使凭证齐全），适合离线演示
SHOPPING_MCP_MOCK=
